{
  "name": "@auto-design/core",
  "version": "0.1.0",
  "description": "Config schema, design engines and compiler for auto-design systems",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && cp src/site/renderer.css src/site/renderer.js dist/"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1"
  }
}
