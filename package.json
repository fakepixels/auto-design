{
  "name": "auto-design-monorepo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "ad": "auto-design",
    "dev": "auto-design dev --cwd examples/quiet-design --app examples/next-quiet"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.13.0",
    "stylelint": "^17.16.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
